---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { RecipePageIsland } from "../../components/RecipePageIsland";
import { deriveTotalTime } from "../../lib/recipeTime.mjs";
import { splitBody } from "../../lib/recipeBody.mjs";
import { getEnriched } from "../../lib/enrichment";
import { displayFromSlug } from "../../utils/displayFromSlug";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes.map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;

const recipes = await getCollection("recipes");
const recipe = recipes.find((r) => r.slug === slug);

if (!recipe) throw new Error(`Recipe not found: ${slug}`);

const d = recipe.data;

// Ingredients: the content schema already normalises string input to string[]
const ingredients: string[] = d.ingredients ?? [];

// Steps + closing note: parse numbered list items and trailing prose from the raw markdown body
const { steps, note } = splitBody(recipe.body);

const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");

// Enrichment lookup (null when this recipe isn't in the KG export)
const enriched = getEnriched(slug!);
const nutrition = enriched?.nutritionPerServing ?? null;
const enrichedSteps = enriched?.steps ?? null;
const enrichedIngredients = enriched?.ingredients ?? null;

// Kitchen-journal marginalia for this recipe (empty when none exist)
const journalEntries =
  (await getCollection("journal")).find((j) => j.data.slug === slug)?.data.entries ?? [];
---

<BaseLayout title={d.title} currentRecipeId={recipe.slug}>
  <RecipePageIsland
    title={d.title}
    slug={recipe.slug}
    intro={d.intro ?? null}
    cuisine={displayFromSlug(d.cuisine)}
    totalTimeMinutes={deriveTotalTime(d)}
    prepTimeMinutes={d.prepTimeMinutes ?? null}
    cookTimeMinutes={d.cookTimeMinutes ?? null}
    marinadeTimeMinutes={d.marinadeTimeMinutes ?? null}
    servings={d.servings ?? 4}
    image={d.image ?? null}
    foodType={d.foodType ?? null}
    tags={d.tags ?? []}
    ingredients={ingredients}
    steps={steps}
    note={note}
    nutrition={nutrition}
    enrichedSteps={enrichedSteps}
    enrichedIngredients={enrichedIngredients}
    journal={journalEntries}
    basePath={basePath}
    client:load
  />
</BaseLayout>
